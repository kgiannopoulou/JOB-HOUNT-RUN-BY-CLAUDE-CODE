# Copy to .env.local. Never commit real values.

# Base URL of this app, used in email links.
SITE_URL=http://localhost:3000

# Supabase project URL and publishable key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server only. Protects the job sync endpoint. Use a long random value.
CRON_SECRET=

# Server only. Without a key the app runs and AI features explain they are off.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional. AI calls allowed per user in 24 hours. Defaults to 30.
AI_DAILY_LIMIT=
